C<T: Ord & Copy> = T: Ord & Copy
func<T: x <: Ord & Copy> T clamp2(T v, T lo, T hi) {
  if v < lo: lo
  elif v > hi: hi
  else v
}

func<(
  T: x <: Ord & Copy
)> T clamp2(T v, T lo, T hi) {
  if v < lo: lo
  elif v > hi: hi
  else v
}

